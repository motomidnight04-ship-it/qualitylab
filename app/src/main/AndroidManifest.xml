<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".QualityApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QualityLab">

        <!-- Нужно для Macrobenchmark / Profiler на release-подобной сборке -->
        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.OrderActivity" android:label="@string/title_order" android:parentActivityName=".ui.MainActivity" />
        <activity android:name=".ui.ResultActivity" android:label="@string/title_result" android:parentActivityName=".ui.OrderActivity" />
        <activity android:name=".ui.TasksActivity" android:label="@string/title_tasks" android:parentActivityName=".ui.MainActivity" />
        <activity android:name=".ui.NetworkActivity" android:label="@string/title_network" android:parentActivityName=".ui.MainActivity" />
        <activity android:name=".ui.CrashActivity" android:label="@string/title_crash" android:parentActivityName=".ui.MainActivity" />
        <activity android:name=".ui.LeakActivity" android:label="@string/title_leak" android:parentActivityName=".ui.MainActivity" />
    </application>

</manifest>
